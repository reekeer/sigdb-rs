{
  "headers-rule": {"headers": {"X-Generator": "Drupal"}},
  "js-rule": {"js": "React"},
  "meta-rule": {"meta": {"generator": "WordPress"}},
  "html-string": {"html": "tag:canvas"},
  "html-tag": {"html": {"tag": "svelte-app"}},
  "html-tag-attr": {"html": {"tag": "div", "attr": "data-reactroot"}},
  "html-attr-value": {"html": {"attr": "ng-version", "value": "17"}},
  "html-full": {"html": {"tag": "meta", "attr": "name", "value": "shopify-checkout-api-token"}},
  "html-list": {"html": ["tag:blink", {"attr": "data-turbo"}]},
  "script-src-rule": {"script_src": "cdn.jsdelivr.net"},
  "css-rule": {"css": "bootstrap.min.css"},
  "url-rule": {"url": "/wp-admin"},
  "path-rule": {"path": "/.git/HEAD"},
  "file-rule": {"file": "composer.json"},
  "dns-rule": {"dns": "v=spf1 include:_spf.google.com"},
  "subdomain-rule": {"subdomain": "jenkins"},
  "link-rule": {"link": "rel=preconnect"},
  "json-rule": {"json": "\"__NEXT_DATA__\""},
  "api-rule": {"api": "/graphql"},
  "tls-rule": {"tls": "Let's Encrypt"},
  "server-rule": {"server": "Caddy"},
  "framework-rule": {"framework": "Django"},
  "cms-rule": {"cms": "Ghost"},
  "cdn-rule": {"cdn": "Akamai"}
}
